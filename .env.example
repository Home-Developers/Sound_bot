# ========================================================
# НАЛАШТУВАННЯ DISCORD БОТА
# ========================================================

# Токен вашого Discord бота (Обов'язково!)
# Отримати токен можна тут: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Префікс для звичайних текстових команд (за замовчуванням !)
COMMAND_PREFIX=!

# ========================================================
# НАЛАШТУВАННЯ SPOTIFY (НЕОБОВ'ЯЗКОВО)
# ========================================================
# Потрібно для швидкого парсингу великих плейлистів та альбомів Spotify.
# Якщо не вказано, бот використовує резервний embed-парсер без ключів.
# Отримати можна в кабінеті розробника: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ========================================================
# FFMPEG (НЕОБОВ'ЯЗКОВО)
# ========================================================
# Якщо FFmpeg встановлено в системі (або через WinGet / у папці з ботом),
# бот знайде його автоматично. Якщо потрібно вказати вручну:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
